# Idle with the A/C and a neutral blip (R9), with the app's live session (plan 6 Task 10): cam_in and ign98_is on at idle.
drive idle
start seasoned
set coolant=90 oil=90 intake=33 ambient=20
3 on
kline connect                  # the MS43 logger app: connected at the key-on (125,000 baud), polling the live frame,
kline poll                     # and a 0x6D status every second, the keep-alive the overlay needs (plan 6 contract)
kline every 1 6D 00
kline send 6D 01 03 00 00      # load cam_in at 0
kline send 6D 01 01 00 C0      # load ign98_is at 192
1.5 crank rpm=200
2 idle
kline send 6D 03 03 00 00      # on, edit sum 0
kline send 6D 03 01 00 00
18 idle
5 idle ac=1                            # the A/C request
3 drive gear=N rpm=2500 speed=0        # a blip in neutral at a standstill
2 drive gear=N rpm=2500..900 speed=0
20 idle
