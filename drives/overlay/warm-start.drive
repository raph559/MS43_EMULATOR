# The warm start (plan 4 C5) with the app's live session (plan 6 Task 10): ign98_is, af98 and cam_ex loaded at the key-on
# as copies of the flashed tables and switched on at idle (an identical copy's edit sum is 0). The key-off's after-run
# writes the EEPROM the seasoned overlay drives start from.
drive warm-start
start blank
set coolant=90 oil=90 intake=33 ambient=20 clock=60   # a warm engine on a mild day, the clock at 01:00
3 on
kline connect                  # the MS43 logger app: connected at the key-on (125,000 baud), polling the live frame,
kline poll                     # and a 0x6D status every second, the keep-alive the overlay needs (plan 6 contract)
kline every 1 6D 00
kline send 6D 01 01 00 00      # load ign98_is at 0
kline send 6D 01 02 00 24      # load af98 at 36
kline send 6D 01 04 00 E4      # load cam_ex at 228
1.5 crank rpm=200
2 idle
kline send 6D 03 01 00 00      # on, edit sum 0
kline send 6D 03 02 00 00
kline send 6D 03 04 00 00
38 idle             # the warm idle settles on its 900 rpm target
15 off              # key off: the after-run writes the EEPROM and the main relay drops
