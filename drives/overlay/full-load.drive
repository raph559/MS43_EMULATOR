# Full load to the limiter (R7, R12), with the app's live session (plan 6 Task 10): ign98_pl, af98 and ign98_is on from
# the idle.
drive full-load
start seasoned
set coolant=90 oil=90 intake=33 ambient=20
3 on
kline connect                  # the MS43 logger app: connected at the key-on (125,000 baud), polling the live frame,
kline poll                     # and a 0x6D status every second, the keep-alive the overlay needs (plan 6 contract)
kline every 1 6D 00
kline send 6D 01 00 00 00      # load ign98_pl at 0
kline send 6D 01 02 01 40      # load af98 at 320
kline send 6D 01 01 02 00      # load ign98_is at 512
1.5 crank rpm=200
2 idle
kline send 6D 03 00 55 0B 59 DE      # on, full-copy CRC32
kline send 6D 03 02 90 08 89 8C
kline send 6D 03 01 E7 80 CD 61
4 idle
8 drive gear=3 speed=50..150 pedal=95            # the pull
2 drive gear=3 rpm=6900                          # just below the 7,008 rpm limiter
1 drive gear=3 rpm=7100                          # past the limiter for 1 s
0.4 drive gear=3 speed=150 pedal=95 clutch=1     # the no-lift shift
3 drive gear=4 speed=150..90 pedal=95 clutch=0
6 drive gear=4 speed=90..20 pedal=0              # the coast
3 idle
