# V10 pops stabs: pops' lift (4th, 110 km/h, 16.5 s), 10 s long, for the load and five stabs.
drive v10-pops-stabs
start blank
set coolant=90 oil=90 intake=33 ambient=20
3 on
1.5 crank rpm=200
6 idle
6 drive gear=4 speed=25..110 pedal=30
10 drive gear=4 speed=110..30 pedal=0
2 drive gear=4 speed=30 pedal=0 clutch=1
3 idle clutch=0
