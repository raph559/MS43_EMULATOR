# V10.1 pops on a slope: a lift in 3rd at 110 km/h (16.5 s) slowing to 105 km/h through the 2.0 s load, then downhill
# from 19.5 s: the road speed rises 6 km/h (about 270 rpm, 4,670 to 4,940) with the pedal at 0. With V10.1's 480 rpm
# allowed once stabbing the window runs its 4.0 s; with 139 byte 4 = 5 (V10's 160 rpm) it ends on the slope.
drive v10-pops-downhill-v101
start blank
set coolant=90 oil=90 intake=33 ambient=20
3 on
1.5 crank rpm=200
6 idle
6 drive gear=3 speed=25..110 pedal=40
3 drive gear=3 speed=110..105 pedal=0
1.5 drive gear=3 speed=105..111 pedal=0
8 drive gear=3 speed=111..22 pedal=0
2 drive gear=3 speed=22 pedal=0 clutch=1
3 idle clutch=0
