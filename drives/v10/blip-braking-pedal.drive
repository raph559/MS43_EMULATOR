# V10.2's review (2026-11-08): the braking blip with the pedal pressed while the cap holds. As blip-braking, with the
# pedal at 30 % from 19.2 s, 0.3 s into the hold at 2,700 rpm (above 3rd's target at 57 km/h), through the clutch
# coming out in 3rd.
drive v10-blip-braking-pedal
start blank
set coolant=90 oil=90 intake=33 ambient=20
3 on
1.5 crank rpm=200
6 idle
6 drive gear=4 speed=25..60 pedal=20
2 drive gear=4 speed=60 pedal=0
0.4 drive gear=N clutch=1 brake=1 rpm=1300..2700 speed=60..58
0.3 drive gear=N clutch=1 brake=1 rpm=2700 speed=58..57.5
0.3 drive gear=N clutch=1 brake=0 rpm=2700 speed=57.5..57 pedal=30
2 drive gear=3 clutch=0 brake=0 speed=57..40 pedal=30
2 drive gear=N clutch=1 rpm=1800..800 speed=40..0 pedal=0
3 idle clutch=0
