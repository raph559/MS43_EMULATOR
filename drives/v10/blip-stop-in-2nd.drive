# V10, braking to a stop in 2nd: from 35 km/h, the brake at 16.5 s, the clutch in from 30 km/h at 17.5 s, to a stop.
drive v10-blip-stop-in-2nd
start blank
set coolant=90 oil=90 intake=33 ambient=20
3 on
1.5 crank rpm=200
6 idle
6 drive gear=2 speed=25..35 pedal=30
1 drive gear=2 speed=35..30 pedal=0 brake=1
3 drive gear=N clutch=1 brake=1 rpm=1000..800 speed=30..0 pedal=0
3 idle clutch=0 brake=0
