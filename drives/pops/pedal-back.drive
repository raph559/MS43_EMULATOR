# Pops: a lift at 110 km/h (16.5 s), the pedal back at 18.5 s.
drive pops-pedal-back
start blank
set coolant=90 oil=90 intake=33 ambient=20
3 on
1.5 crank rpm=200
6 idle
6 drive gear=4 speed=25..110 pedal=30
2 drive gear=4 speed=110..95 pedal=0
3 drive gear=4 speed=95..100 pedal=30
3 drive gear=N rpm=3200..900 speed=100..30 pedal=0 clutch=1
3 idle
