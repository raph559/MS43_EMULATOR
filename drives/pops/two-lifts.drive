# Pops: two lifts (16.5 s and 21.5 s) with the pedal pressed between them.
drive pops-two-lifts
start blank
set coolant=90 oil=90 intake=33 ambient=20
3 on
1.5 crank rpm=200
6 idle
6 drive gear=4 speed=25..110 pedal=30
3 drive gear=4 speed=110..95 pedal=0
2 drive gear=4 speed=95..105 pedal=30
4 drive gear=4 speed=105..80 pedal=0
3 drive gear=N rpm=2550..900 speed=80..30 pedal=0 clutch=1
3 idle
