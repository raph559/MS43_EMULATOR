# Idle with the A/C and a neutral blip (R9), from the seasoned EEPROM.
drive idle
start seasoned
set coolant=90 oil=90 intake=33 ambient=20
3 on
1.5 crank rpm=200
20 idle
5 idle ac=1                            # the A/C request: the relay comes on; the idle flares and holds its 900 rpm (R9)
3 drive gear=N rpm=2500 speed=0        # a blip in neutral at a standstill
2 drive gear=N rpm=2500..900 speed=0   # eased back to idle, so the hand-off to the idle plant is gentle
20 idle
